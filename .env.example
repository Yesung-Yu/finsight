# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 Git에 올리지 않는다)

# 네이버 검색 API (필수: 뉴스 수집) — https://developers.naver.com/apps 에서 애플리케이션 등록, "검색" API 선택
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# KRX 정보데이터시스템 계정 (선택: 전체 종목 목록, 시가총액, PER, PBR) — https://data.krx.co.kr 무료 회원가입
# 비워 두면 내장 시연 종목 10개만 이름으로 검색되고, 시가총액·PER·PBR은 "-"로 표시된다.
KRX_ID=
KRX_PW=
