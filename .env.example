# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 Git에 올리지 않는다)

# 네이버 검색 API (필수: 뉴스 수집) — NAVER API HUB(네이버클라우드 콘솔)에서 Application 등록 후 "검색" API 선택
# (네이버 개발자센터는 2026-07-31부터 검색 API 신규 신청 불가)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 예전 개발자센터에서 받은 키를 쓰는 경우에만 legacy 로 바꾼다 (2027-06-30까지 동작)
NAVER_API=hub

# KRX 정보데이터시스템 계정 (선택: 전체 종목 목록, 시가총액, PER, PBR) — https://data.krx.co.kr 무료 일반 회원가입
# (아이디·비밀번호 방식만 가능. 네이버 간편로그인 계정은 안 됨)
# 비워 두면 내장 시연 종목 10개만 이름으로 검색되고, 시가총액·PER·PBR은 "-"로 표시된다.
KRX_ID=
KRX_PW=

# 전시 모드 (선택): 1 이면 "데이터 새로고침" 버튼을 숨긴다. scripts/serve_kiosk.ps1 이 자동으로 켠다.
FINSIGHT_KIOSK=
